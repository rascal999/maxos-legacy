#!/bin/sh
# Click at given coordinates, then restore mouse position, ONLY if on "1: web" workspace.
# Usage: click-opencode <x> <y> [screen]

X=$1
Y=$2
SCREEN=${3:-0}

if [ -z "$X" ] || [ -z "$Y" ]; then
    echo "Usage: click-opencode <x> <y> [screen]" >&2
    exit 1
fi

# Only proceed if we are on the "1: web" workspace
if ! i3-msg -t get_workspaces | jq -e '.[] | select(.focused and .name == "1: web")' >/dev/null 2>&1; then
    exit 0
fi

# Save current mouse position
OLD_X=$(xdotool getmouselocation | sed 's/.*x:\([0-9]*\) .*/\1/')
OLD_Y=$(xdotool getmouselocation | sed 's/.*y:\([0-9]*\) .*/\1/')

# Move to the target and click
xdotool mousemove --screen "$SCREEN" "$X" "$Y"
xdotool click 1

# Restore original position
xdotool mousemove "$OLD_X" "$OLD_Y"
