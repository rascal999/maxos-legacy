#!/bin/sh
# Toggle VSCode between DP-2 (focused workspace, fullscreen) and "2: code" (not fullscreen).
#
# - If VSCode is NOT on DP-2: move to focused workspace on DP-2, fullscreen
# - If VSCode IS on DP-2:     send to "2: code", disable fullscreen

# Get the visible workspace on DP-2
dp2_ws=$(i3-msg -t get_workspaces | jq -r '.[] | select(.output == "DP-2" and .visible) | .name')

# Find the output VSCode is currently on
vscode_output=$(i3-msg -t get_tree | jq -r '.. | select(.window_properties?.class? == "Code") | .output' | head -n1)
vscode_ws=$(i3-msg -t get_tree | jq -r '.. | select(.type? == "workspace") | select(any(..; .window_properties?.class? == "Code")) | .name' | head -n1)

# If VSCode is not running, launch it
if [ -z "$vscode_ws" ]; then
    i3-msg "workspace \"2: code\"; exec code"
    exit 0
fi

if [ "$vscode_output" != "DP-2" ]; then
    # VSCode is not on DP-2 — focus it first, move to DP-2 active workspace, fullscreen, and refocus on DP-2
    # This prevents the mouse from being dragged or left on DP-4
    i3-msg "[class=\"^Code$\"] focus; move to workspace \"$dp2_ws\"; [class=\"^Code$\"] fullscreen enable; [class=\"^Code$\"] focus"
else
    # VSCode is on DP-2 — focus it first, disable fullscreen, and move back to "2: code"
    i3-msg "[class=\"^Code$\"] focus; [class=\"^Code$\"] fullscreen disable; move to workspace \"2: code\""
fi
